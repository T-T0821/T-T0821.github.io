{
  "devDependencies": {
    "@types/node": "^25.3.5",
    "vitepress": "^2.0.0-alpha.16"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "digest:trending": "NODE_USE_ENV_PROXY=1 node scripts/trending/collect.mjs",
    "digest:news": "NODE_USE_ENV_PROXY=1 node scripts/news/collect.mjs",
    "digest": "npm run digest:trending; npm run digest:news",
    "conf:due": "node scripts/conferences/due.mjs",
    "conf:ochiai": "NODE_USE_ENV_PROXY=1 node scripts/conferences/ochiai.mjs",
    "conf:render": "node scripts/conferences/render.mjs"
  }
}
